{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "default",
  "description": "Default permissions for COROS Dashboard",
  "remote": {
    "urls": ["http://127.0.0.1:43124*"]
  },
  "windows": ["main"],
  "permissions": [
    "core:default",
    "updater:default",
    "process:default",
    "shell:allow-open",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "server",
          "sidecar": true
        }
      ]
    }
  ]
}
