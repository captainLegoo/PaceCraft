{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "COROS Dashboard",
  "version": "1.0.0",
  "identifier": "com.coros.dashboard",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://127.0.0.1:43125",
    "beforeBuildCommand": "bun run build:all",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "COROS 训练看板",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/server"
    ]
  }
}
