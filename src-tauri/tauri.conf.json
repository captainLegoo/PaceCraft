{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PaceCraft",
  "version": "0.1.8",
  "identifier": "com.pacecraft.app",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://127.0.0.1:43125",
    "beforeBuildCommand": "",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "PaceCraft - 跑者 AI 训练中心",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/server"
    ],
    "macOS": {
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    },
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
