# ========================================================
# COROS 训练看板环境变量配置示例 (Environment Variables)
# 可按需复制本文件为 .env 或在运行环境中导出
# ========================================================

# ---------- COROS 账号区服与 OAuth 网关 ----------
# 中国区账号（默认）：https://mcpcn.coros.com
# 海外 / 国际区账号（Global / US / EU 等）：https://mcp.coros.com
COROS_ISSUER=https://mcpcn.coros.com
COROS_MCP_URL=https://mcpcn.coros.com/mcp

# OAuth 本地回调端口（浏览器授权后自动回调，默认 43123）
# COROS_REDIRECT_PORT=43123

# ---------- 本地数据存储目录 ----------
# 默认为当前用户家目录下的 ~/.coros-dashboard
# 数据库文件为 $COROS_DATA_DIR/coros.db，凭证为 $COROS_DATA_DIR/tokens.json
# COROS_DATA_DIR=/Users/your_username/.coros-dashboard

# ---------- 服务网络与监听端口 ----------
# 后端服务端口（默认 43124）
# PORT=43124

# 服务监听地址：
# - 127.0.0.1（默认）：仅限本机访问，最安全
# - 0.0.0.0：局域网内其他设备（如手机/平板）可访问
# HOST=127.0.0.1

# 前端开发服务器地址（仅本地多端口开发时用于 CORS 匹配，默认 http://localhost:43125）
# WEB_ORIGIN=http://localhost:43125
