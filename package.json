{
  "name": "pacecraft",
  "version": "0.1.14",
  "description": "PaceCraft - 跨生态跑者 AI 数据与训练中心",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "./dev.sh",
    "auth": "bun run --cwd server auth",
    "dev:server": "bun run --cwd server dev",
    "dev:web": "bun run --cwd web dev",
    "build": "bun run --cwd web build",
    "build:web": "bun run --cwd web build",
    "build:embed": "bun run scripts/bundle-dist.ts",
    "build:sidecar": "bun run build:embed && bun run scripts/build-sidecar.ts",
    "build:all": "bun run build:web && bun run build:sidecar",
    "clean:test": "bun run server/src/cli/clean-test-data.ts",
    "sync": "bun run --cwd server sync",
    "probe": "bun run --cwd server probe",
    "shoot": "bun run .shots/shoot.ts",
    "shoot:mobile": "bun run .shots/mobile-check.ts",
    "pack": "./scripts/deploy/pack.sh",
    "tauri": "tauri"
  },
  "devDependencies": {
    "playwright-core": "^1.63.0"
  }
}
